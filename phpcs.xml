<?xml version="1.0"?>
<ruleset name="WP-RelativeDate">
	<description>WordPress Coding Standards for WP-RelativeDate.</description>

	<file>.</file>

	<!-- WPCS has no JavaScript sniffs; never let PHPCS touch .js. -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Scanning these makes the CI runner run out of memory. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<rule ref="WordPress"/>

	<config name="text_domain" value="wp-relativedate"/>
	<config name="minimum_wp_version" value="6.0"/>

	<!--
		Test files are named test-*.php by WordPress convention rather than
		class-*.php; the coding standard excepts test classes from that rule.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		A test method's name is its documentation. Requiring a docblock on
		test_a_future_post_on_the_same_day_gets_no_relative_suffix() would only
		get one repeating it. Required everywhere else.
	-->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.ShortNotCapital">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		The fixtures deliberately read and write the site's timezone options and
		build DateTimeImmutable objects by hand, which is the whole point of a
		suite about relative dates.
	-->
	<rule ref="WordPress.DateTime.RestrictedFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		the_date() prints nothing unless is_new_day() says so, and is_new_day()
		reads $currentday and $previousday. Setting them is the only way to
		exercise the one path where the plugin must NOT relativise, so the
		tests that cover it have to write the globals a loop would.
	-->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		tests/bootstrap.php prints its "where is the test library?" diagnostic
		before the WordPress bootstrap has run, so esc_html() does not exist yet
		to escape it with. The string is a literal and a path this repo supplied.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/bootstrap.php</exclude-pattern>
	</rule>

	<!--
		The source-level guards read the plugin's own files off local disk, and
		must read them raw: php_strip_whitespace() would remove the very
		docblocks one of them asserts on. wp_remote_get() is for URLs, and
		WP_Filesystem is neither initialised nor appropriate in a test.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
